<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="460.0" prefWidth="680.0" style="-fx-border-radius: 30;" stylesheets="@../../../css/StyleHome.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="UiController.ChatController">
   <children>
      <TextArea fx:id="textArea" layoutX="7.0" layoutY="394.0" prefHeight="47.0" prefWidth="665.0" promptText="Message" style="-fx-background-radius: 40;">
         <font>
            <Font name="System Bold" size="17.0" />
         </font>
      </TextArea>
      <Button fx:id="sendMessage" layoutX="604.0" layoutY="394.0" mnemonicParsing="false" onAction="#sendMessageAction" prefHeight="52.0" prefWidth="68.0" style="-fx-background-radius: 40;" text="Button" />
      <ListView fx:id="listView" layoutX="10.0" layoutY="41.0" prefHeight="337.0" prefWidth="665.0" />
      <Button fx:id="btnBack" layoutX="10.0" layoutY="7.0" mnemonicParsing="false" onAction="#btnBackAction" style="-fx-background-color: #f21d56;" text="back" />
   </children>
</AnchorPane>
