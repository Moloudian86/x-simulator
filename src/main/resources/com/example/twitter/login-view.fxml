<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane  stylesheets="@../../../css/StyleSignUp.css"  prefHeight="460.0" prefWidth="680.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="UiController.LoginController">
   <children>
      <Label alignment="CENTER" layoutX="246.0" layoutY="80.0" prefHeight="83.0" prefWidth="210.0" text="Login">
         <font>
            <Font name="Segoe UI Bold" size="18.0" />
         </font>
      </Label>
      <TextField fx:id="usernameLogin" layoutX="262.0" layoutY="160.0" prefHeight="37.0" prefWidth="180.0" promptText="Username">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </TextField>
      <TextField fx:id="passwordLogin" layoutX="262.0" layoutY="220.0" prefHeight="37.0" prefWidth="180.0" promptText="password">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </TextField>
      <Button fx:id="btnLogin" alignment="CENTER" layoutX="302.0" layoutY="280.0" mnemonicParsing="false" onAction="#btnLoginAction" prefHeight="37.0" prefWidth="100.0" style="-fx-background-color: #1DA1F2;" text="Login" />
      <Button fx:id="btnSignUp" layoutX="323.0" layoutY="330.0" mnemonicParsing="false" onAction="#btnSignUpAction" style="-fx-background-color: #00000000;" text="Sign Up" />
   </children>
</AnchorPane>
