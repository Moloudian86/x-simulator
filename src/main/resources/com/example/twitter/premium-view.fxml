<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="textFil" prefHeight="460.0" prefWidth="680.0" stylesheets="@../../../css/StyleHome.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="UiController.PremiumController">
   <children>
      <AnchorPane prefHeight="460.0" prefWidth="194.0" style="-fx-background-color: #D2D1D2;">
         <children>
            <Button fx:id="btnHome" layoutX="49.0" layoutY="30.0" mnemonicParsing="false" onAction="#btnHomeAction" prefHeight="37.0" prefWidth="95.0" text="Home" />
            <Button fx:id="btnSearch" layoutX="49.0" layoutY="74.0" mnemonicParsing="false" onAction="#btnSearchAction" prefHeight="37.0" prefWidth="95.0" text="Search" />
            <Button fx:id="btnPorofile" layoutX="49.0" layoutY="120.0" mnemonicParsing="false" onAction="#btnPorofileAction" prefHeight="37.0" prefWidth="95.0" text="Profile" />
            <Button fx:id="btnNew" layoutX="49.0" layoutY="165.0" mnemonicParsing="false" onAction="#btnNewAction" prefHeight="37.0" prefWidth="95.0" text="New" />
            <Button fx:id="btnLogOut" layoutX="49.0" layoutY="400.0" mnemonicParsing="false" onAction="#btnLogOutAction" prefHeight="37.0" prefWidth="95.0" text="Log Out" />
            <Button fx:id="btnPremium" layoutX="49.0" layoutY="210.0" mnemonicParsing="false" onAction="#btnPremiumAction" prefHeight="37.0" prefWidth="95.0" text="Premium" />
         </children>
      </AnchorPane>
      <HBox layoutX="200.0" layoutY="60.0" prefHeight="37.0" prefWidth="140.0" style="-fx-border-color: black; -fx-border-radius: 30;">
         <children>
            <Label prefHeight="37.0" prefWidth="41.0" text="Token:">
               <HBox.margin>
                  <Insets left="10.0" />
               </HBox.margin>
            </Label>
            <Label fx:id="tokenLabel" prefHeight="40.0" prefWidth="83.0" />
         </children>
      </HBox>
      <HBox layoutX="200.0" layoutY="14.0" prefHeight="37.0" prefWidth="140.0" style="-fx-border-color: black; -fx-border-radius: 30;">
         <children>
            <Label prefHeight="37.0" prefWidth="40.0" text="Credit:">
               <HBox.margin>
                  <Insets left="10.0" />
               </HBox.margin>
            </Label>
            <Label fx:id="creditLabel" prefHeight="40.0" prefWidth="83.0" />
         </children>
      </HBox>
      <Button fx:id="btnBlueSubscription" layoutX="317.0" layoutY="168.0" mnemonicParsing="false" onAction="#btnBlueSubscriptionAction" prefHeight="62.0" prefWidth="221.0" style="-fx-background-color: #1DA1F2;" text="Blue Subscription: 9Dollar">
         <font>
            <Font size="16.0" />
         </font>
      </Button>
      <Button fx:id="btnGoldSubscription" layoutX="317.0" layoutY="253.0" mnemonicParsing="false" onAction="#btnGoldSubscriptionAction" prefHeight="62.0" prefWidth="221.0" style="-fx-background-color: #FFD700;" text="Gold Subscription: 19Dollar">
         <font>
            <Font size="16.0" />
         </font>
      </Button>
      <TextField fx:id="textFieldDollarAmount" layoutX="401.0" layoutY="15.0" prefHeight="35.0" prefWidth="243.0" promptText="Enter dollar amount" style="-fx-background-radius: 30;" />
      <Button fx:id="btnBuyToken" layoutX="570.0" layoutY="15.0" mnemonicParsing="false" onAction="#btnBuyTokenAction" prefHeight="35.0" prefWidth="74.0" style="-fx-background-color: #3FD5AE;" text="Buy Token" />
   </children>
</AnchorPane>
