<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="460.0" prefWidth="680.0" stylesheets="@../../../css/StyleHome.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="UiController.ProfileController">
   <children>
      <VBox layoutX="194.0" layoutY="14.0" prefHeight="441.0" prefWidth="355.0">
         <children>
            <VBox prefHeight="166.0" prefWidth="355.0">
               <children>
                  <HBox prefHeight="40.0" prefWidth="355.0">
                     <children>
                        <ImageView fx:id="imageView" fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
                        <Label alignment="CENTER" prefHeight="33.0" prefWidth="77.0" text="Username:" />
                        <Label fx:id="usernameLabel" prefHeight="27.0" prefWidth="181.0" />
                     </children>
                  </HBox>
                  <HBox prefHeight="40.0" prefWidth="355.0">
                     <children>
                        <Label alignment="CENTER" prefHeight="61.0" prefWidth="75.0" text="Bio:" />
                        <Label fx:id="bioLable" prefHeight="27.0" prefWidth="181.0" />
                     </children>
                  </HBox>
                  <HBox prefHeight="62.0" prefWidth="355.0">
                     <children>
                        <Label fx:id="followersLabel" alignment="CENTER" prefHeight="41.0" prefWidth="41.0" />
                        <Button fx:id="btnFollowers" mnemonicParsing="false" onAction="#btnFollowersAction" prefHeight="40.0" prefWidth="115.0" text="Followers">
                           <HBox.margin>
                              <Insets top="7.0" />
                           </HBox.margin>
                        </Button>
                     </children>
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                  </HBox>
                  <HBox prefHeight="51.0" prefWidth="355.0">
                     <children>
                        <Label fx:id="followingLable" alignment="CENTER" prefHeight="40.0" prefWidth="41.0" />
                        <Button fx:id="btnFollowing" mnemonicParsing="false" onAction="#btnFollowingAction" prefHeight="40.0" prefWidth="115.0" text="Following" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <VBox fx:id="privateVbox" prefHeight="84.0" prefWidth="355.0">
               <children>
                  <HBox prefHeight="64.0" prefWidth="418.0">
                     <children>
                        <Label alignment="CENTER" prefHeight="77.0" prefWidth="99.0" text="Email:" />
                        <Label fx:id="emailLabel" prefHeight="70.0" prefWidth="193.0" />
                     </children>
                  </HBox>
                  <HBox prefHeight="71.0" prefWidth="418.0">
                     <children>
                        <Label alignment="CENTER" prefHeight="73.0" prefWidth="101.0" text="Password:" />
                        <Label fx:id="passwordLabel" prefHeight="70.0" prefWidth="196.0" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <Label fx:id="labelPosts" alignment="CENTER" prefHeight="36.0" prefWidth="40.0" style="-fx-background-color: skyblue;" text="Posts:">
               <font>
                  <Font size="11.0" />
               </font>
            </Label>
            <ListView fx:id="listView" prefHeight="250.0" prefWidth="418.0" />
         </children>
      </VBox>
      <VBox layoutX="549.0" layoutY="14.0" prefHeight="169.0" prefWidth="115.0" spacing="10.0">
         <children>
            <Button fx:id="btnEditProfile" contentDisplay="CENTER" mnemonicParsing="false" onAction="#btnEditProfileAction" prefHeight="37.0" prefWidth="95.0" style="-fx-background-color: #1DA1F2;" text="Edit profile" />
            <Button fx:id="btnProfileImage" mnemonicParsing="false" onAction="#btnProfileImageAction" prefHeight="37.0" prefWidth="89.0" text="Profile Image" />
            <Button fx:id="btnFollow" mnemonicParsing="false" onAction="#btnFollowAction" prefHeight="37.0" prefWidth="89.0" />
         </children>
         <padding>
            <Insets bottom="10.0" left="15.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
      <AnchorPane prefHeight="460.0" prefWidth="194.0" style="-fx-background-color: #D2D1D2;">
         <children>
            <Button fx:id="btnHome" layoutX="49.0" layoutY="30.0" mnemonicParsing="false" onAction="#btnHomeAction" prefHeight="37.0" prefWidth="95.0" text="Home" />
            <Button fx:id="btnSearch" layoutX="49.0" layoutY="74.0" mnemonicParsing="false" onAction="#btnSearchAction" prefHeight="37.0" prefWidth="95.0" text="Search" />
            <Button fx:id="btnPorofile" layoutX="49.0" layoutY="120.0" mnemonicParsing="false" onAction="#btnPorofileAction" prefHeight="37.0" prefWidth="95.0" text="Profile" />
            <Button fx:id="btnNew" layoutX="49.0" layoutY="165.0" mnemonicParsing="false" onAction="#btnNewAction" prefHeight="37.0" prefWidth="95.0" text="New" />
            <Button fx:id="btnLogOut" layoutX="49.0" layoutY="400.0" mnemonicParsing="false" onAction="#btnLogOutAction" prefHeight="37.0" prefWidth="95.0" text="Log Out" />
            <Button fx:id="btnPremium" layoutX="49.0" layoutY="210.0" mnemonicParsing="false" onAction="#btnPremiumAction" prefHeight="37.0" prefWidth="95.0" text="Premium" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
